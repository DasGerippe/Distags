{
  "profiles": {
    "Run All": {
      "commandName": "Project",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    "Run MaxterCsvImporter": {
      "commandName": "Project",
      "commandLineArgs": "MaxterCsvImporter",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    "Run LevelType, GameMode, MissingLevel": {
      "commandName": "Project",
      "commandLineArgs": "LevelTypeAutoTagger GameModeAutoTagger MissingLevelAutoTagger",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    }
  }
}