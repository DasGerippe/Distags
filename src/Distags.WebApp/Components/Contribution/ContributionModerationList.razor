@using Distags.Api.Contracts
@using Distags.Api.Contracts.Contributions
@using Distags.Api.Contracts.Levels
@using Distags.WebApp.Components.Dialogs
@using Distags.WebApp.DistagsApi
@using Distags.WebApp.Security
@using Distags.WebApp.Services
@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.Net.Http.Headers

@inject ISessionTokenProvider SessionTokenProvider
@inject DistagsApiClient DistagsApi
@inject IDialogService DialogService

<InfiniteScrollContainer OnScrolledToEnd="OnScrolledToEnd" class="d-flex flex-column gap-3 gap-md-2 py-3">
    @foreach (ContributionResponse contribution in Contributions)
    {
        <ContributionDisplay @key="contribution.Id"
                             Contribution="contribution"
                             EnableModeration="true"
                             LevelFilterActive="_LevelFilter != null"
                             UserFilterActive="_UserFilter != null"
                             LevelFilterClicked="ContributionDisplayOnLevelFilterClicked"
                             UserFilterClicked="ContributionDisplayOnUserFilterClicked" />
    }
</InfiniteScrollContainer>

    @code {

    private bool _IsLoadingNextBatch;
    private bool _CachedAllContributions;

    private readonly List<ContributionResponse> _LiveContributions = [];
    private readonly List<ContributionResponse> _CachedContributions = [];

    private LevelResponse? _LevelFilter;
    private ContributionUserResponse? _UserFilter;

    private HubConnection? _ContributionsHubConnection;

    private bool _Disposed;

    private IEnumerable<ContributionResponse> Contributions
    {
        get
        {
            for (int i = _LiveContributions.Count - 1; i >= 0; i--)
            {
                yield return _LiveContributions[i];
            }

            foreach (ContributionResponse cachedContribution in _CachedContributions)
            {
                yield return cachedContribution;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SetUpHubConnection();
            await LoadNextContributionBatch();

            BanUserDialog? banUserDialog = DialogService.Get<BanUserDialog>();
            if (banUserDialog != null)
                banUserDialog.UserBanPosted += OnUserBanPosted;

            RevertContributionsDialog? revertContributionsDialog = DialogService.Get<RevertContributionsDialog>();
            if (revertContributionsDialog != null)
                revertContributionsDialog.ContributionsReverted += OnContributionsReverted;
        }
    }

    private async void OnUserBanPosted(object? sender, ApiResult apiResult)
    {
        try
        {
            if (apiResult.IsSuccess)
                return;

            InfoDialog? infoDialog = DialogService.Get<InfoDialog>();
            if (infoDialog == null)
                return;

            ProblemDetails? problem = apiResult.ProblemDetails;
            string title = string.IsNullOrEmpty(problem?.Title)
                ? $"{problem?.Status} Could not ban user"
                : $"{problem?.Status} {problem?.Title}";
            string message = apiResult.ProblemDetails?.Detail ?? "The user could not be banned.";
            await infoDialog.ShowAsync(title, message);
        }
        catch
        {
            // ignored
        }
    }

    private async void OnContributionsReverted(object? sender, ApiResult responseMessage)
    {
        try
        {
            RevertContributionsResultDialog? revertContributionsResultDialog = DialogService.Get<RevertContributionsResultDialog>();
            if (revertContributionsResultDialog != null)
                await revertContributionsResultDialog.ShowAsync(responseMessage);
        }
        catch
        {
            // ignored
        }
    }

    private async Task SetUpHubConnection()
    {
        _ContributionsHubConnection = new HubConnectionBuilder()
            .WithUrl(DistagsApi.ContributionHubEndpoint, options =>
            {
                options.Headers.Add(
                    HeaderNames.Authorization,
                    $"{DistagsApiConstants.AuthorizationHeaderSchemes.SessionToken} {SessionTokenProvider.SessionToken}");
            })
            .WithAutomaticReconnect()
            .Build();

        _ContributionsHubConnection.On<ContributionResponse>("NewContribution", ProcessNewContribution);

        await _ContributionsHubConnection.StartAsync();
    }

    private async Task ProcessNewContribution(ContributionResponse contribution)
    {
        await InvokeAsync(() =>
        {
            if ((_LevelFilter != null && _LevelFilter.Key != contribution.Level.Key) ||
                (_UserFilter != null && _UserFilter.SteamId != contribution.User?.SteamId))
                return;

            _LiveContributions.Add(contribution);
            StateHasChanged();
        });
    }

    private async Task LoadNextContributionBatch()
    {
        if (_IsLoadingNextBatch)
            return;

        _IsLoadingNextBatch = true;
        await InvokeAsync(StateHasChanged);

        DateTimeOffset? contributedBeforeFilter = _CachedContributions.Count > 0
            ? _CachedContributions[^1].ContributedOn
            : null;

        const int batchSize = 100;
        GetContributionsRequest request = new GetContributionsRequest
        {
            Limit = batchSize,
            ContributedBefore = contributedBeforeFilter,
            LevelSlug = (_LevelFilter as OfficialLevelResponse)?.Slug,
            LevelWorkshopId = (_LevelFilter as WorkshopLevelResponse)?.WorkshopId,
            UserSteamId = _UserFilter?.SteamId,
        };
        ApiResult<ContributionsPageResponse> apiResult = await DistagsApi.GetContributionsAsync(request);
        if (!apiResult.IsSuccess)
            return;

        ContributionsPageResponse contributionsPage = apiResult.Value;
        _CachedContributions.AddRange(contributionsPage.Contributions);
        if (contributionsPage.Contributions.Count < batchSize)
            _CachedAllContributions = true;

        _IsLoadingNextBatch = false;
        await InvokeAsync(StateHasChanged);
    }

    private Task ContributionDisplayOnLevelFilterClicked(LevelResponse level)
    {
        _LevelFilter = _LevelFilter?.Key != level.Key ? level : null;
        return ResetContributions();
    }

    private Task ContributionDisplayOnUserFilterClicked(ContributionUserResponse user)
    {
        _UserFilter = _UserFilter?.SteamId != user.SteamId ? user : null;
        return ResetContributions();
    }

    private Task ResetContributions()
    {
        _CachedContributions.Clear();
        _LiveContributions.Clear();
        _CachedAllContributions = false;
        return LoadNextContributionBatch();
    }

    private async Task OnScrolledToEnd()
    {
        if (!_CachedAllContributions)
            await LoadNextContributionBatch();
    }

    public async ValueTask DisposeAsync()
    {
        if (_Disposed)
            return;

        if (_ContributionsHubConnection != null)
        {
            await _ContributionsHubConnection.DisposeAsync();
            _ContributionsHubConnection = null;
        }

        _Disposed = true;
    }

}
