@using Distags.Api.Contracts.Tags
@using Distags.Contracts

<div class="d-flex flex-column overflow-hidden">
    @foreach (TagChangeResponse tagChange in Changes)
    {
        <div class="d-flex column-gap-1 align-items-center overflow-hidden">
            <svg class="flex-shrink-0" style="width:1rem; height:1rem;">
                <use href="icons.svg#@GetActionIconId(tagChange.Action)"/>
            </svg>
            <span class="text-truncate">@tagChange.TagName</span>
        </div>
    }
</div>

@code {
    
    [Parameter]
    public required List<TagChangeResponse> Changes { get; set; }

    private string GetActionIconId(TagChangeAction action)
    {
        return action switch
        {
            TagChangeAction.Add => "plus-solid",
            TagChangeAction.Remove => "minus-solid",
            _ => throw new ArgumentOutOfRangeException(nameof(action), action, null),
        };
    }

}
