@using Distags.WebApp.DistagsApi

@inherits DialogBase

<Dialog Id="@ModalId">
    <Header>
        <h5 class="modal-title">Revert Contributions Result</h5>
        <button class="btn-close" data-bs-dismiss="modal"></button>
    </Header>
    <Body>
        @if (_ApiResult?.IsSuccess == true)
        {
            <div class="text-center">Success!</div>
        }
        else
        {
            <div>Status Code: @_ApiResult?.StatusCode</div>
            <div>@_ApiResult?.ProblemDetails?.Detail</div>
        }
    </Body>
    <Footer>
        <button class="btn btn-primary" data-bs-dismiss="modal">Close</button>
    </Footer>
</Dialog>

@code {

    private ApiResult? _ApiResult;

    protected override string ModalId => "revertContributionsResultModal";

    public async ValueTask ShowAsync(ApiResult apiResult)
    {
        _ApiResult = apiResult;
        StateHasChanged();

        await ShowAsync();
    }

    public new ValueTask HideAsync()
    {
        return base.HideAsync();
    }

}
