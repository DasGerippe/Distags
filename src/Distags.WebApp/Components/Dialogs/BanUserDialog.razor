@using Distags.Api.Contracts.UserBans
@using Distags.WebApp.DistagsApi

@inherits DialogBase

@inject DistagsApiClient DistagsApi

<Dialog Id="@ModalId">
    <Header>
        <h5 class="modal-title">Ban User</h5>
        <button class="btn-close" data-bs-dismiss="modal"></button>
    </Header>
    <Body>
    <form>
        <label for="banUserSteamIdInput" class="col-form-label">User Steam ID:</label>
        <input id="banUserSteamIdInput" class="form-control" value="@_SteamId" disabled readonly />

        <label for="banUserSteamNameInput" class="col-form-label">User Steam Name:</label>
        <input id="banUserSteamNameInput" class="form-control" value="@_SteamName" disabled readonly />

        <label for="banUserReasonInput" class="col-form-label">Ban Reason:</label>
        <textarea id="banUserReasonInput" class="form-control" @bind="_Reason"></textarea>
    </form>
    </Body>
    <Footer>
        <button class="btn btn-primary" @onclick="SubmitUserBan">Submit Ban</button>
    </Footer>
</Dialog>

@code {

    private long? _SteamId;
    private string? _SteamName;
    private string? _Reason;

    protected override string ModalId => "banUserModal";

    public event EventHandler<ApiResult>? UserBanPosted;

    public async ValueTask ShowAsync(long steamId, string? steamName)
    {
        _SteamId = steamId;
        _SteamName = steamName;
        StateHasChanged();

        await ShowAsync();
    }

    public new ValueTask HideAsync()
    {
        return base.HideAsync();
    }

    private async Task SubmitUserBan()
    {
        if (_SteamId == null)
            return;

        CreateUserBanRequest createUserBanRequest = new CreateUserBanRequest
        {
            SteamId = _SteamId!.Value,
            Reason = _Reason,
        };
        ApiResult apiResult = await DistagsApi.PostUserBanAsync(createUserBanRequest);

        await HideAsync();

        UserBanPosted?.Invoke(this, apiResult);
    }

}
