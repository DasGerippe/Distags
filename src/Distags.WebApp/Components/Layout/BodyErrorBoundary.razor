
@inherits ErrorBoundaryBase

@inject ILogger<BodyErrorBoundary> Logger

@if (CurrentException == null)
{
    @ChildContent
}
else
{
    <div class="container-fluid content-narrow">
        <ErrorDisplay ErrorMessage="@Resource.ErrorMessage_Rendering" ErrorId="@_ErrorId" />
    </div>
}

@code {

    private string _ErrorId = string.Empty;

    protected override Task OnErrorAsync(Exception exception)
    {
        _ErrorId = Guid.NewGuid().ToString("N");

        Logger.LogError(exception, "Unhandled UI exception. Error ID={errorId}", _ErrorId);

        return Task.CompletedTask;
    }

}
