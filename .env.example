DISTAGS_VERSION=

DISTAGS_HOST=
DISTAGS_API_HOST=api.${DISTAGS_HOST}
DISTAGS_WEBAPP_HOST=${DISTAGS_HOST}

### Caddy
# Contact address for Let's Encrypt expiry notices.
ACME_EMAIL=

### Distags Core
# Array of Steam IDs which should be promoted to admin once they log into Distags.
Distags__Core__AdministratorSteamIds__0=

### Distags WebApp
# The URL that the WebApp uses to communicate with the API.
Distags__WebApp__DistagsApiUrlInternal=
# The URL that external clients use to communicate with the API.
Distags__WebApp__DistagsApiUrlExternal=https://${DISTAGS_API_HOST}
