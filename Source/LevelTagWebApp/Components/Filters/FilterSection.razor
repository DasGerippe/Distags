@using System.Text.Json
@using LevelTagApi.Dtos
@using LevelTagWebApp.Filters
@using LevelTagWebApp.Filters.Abilities
@using LevelTagWebApp.Services

<CascadingValue Value="_TagFilterCheckboxLogicProvider">
	<CascadingValue Value="_TagFilterStateIconProvider">
		@foreach (FilterGroupBase filterGroup in _FilterGroups)
		{
			<div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2 my-2">
				<FilterGroupCard FilterGroupBase="filterGroup" />
			</div>
		}
	</CascadingValue>
</CascadingValue>

<div class="text-center">
	<button class="w-75" type="submit" @onclick="QueryLevelsAsync">Query</button>
</div>

@code {

	private readonly List<FilterGroupBase> _FilterGroups =
	[
		new LevelInfoFilterGroup(),
		new DifficultyFilterGroup(),
		new AbilitiesFilterGroup(),
		new GameplayFilterGroup(),
		new GimmicksFilterGroup(),
		new ThemeFilterGroup(),
		new StyleFilterGroup(),
	];

	private TagFilterCheckboxLogicProvider _TagFilterCheckboxLogicProvider = new TagFilterCheckboxLogicProvider();
	private TagFilterStateIconProvider _TagFilterStateIconProvider = new TagFilterStateIconProvider();

	private readonly HttpClient _HttpClient = new HttpClient();

	[Parameter]
	public EventCallback<List<GetLevelDto>> FilesQueried { get; set; }

	private async Task QueryLevelsAsync()
	{
		List<string> requiredTags = GetTagsByState(TagFilterState.Required);
		List<string> forbiddenTags = GetTagsByState(TagFilterState.Forbidden);

		string url = $"https://localhost:7159/api/levels?includeTags={Uri.EscapeDataString(string.Join(',', requiredTags))}&excludeTags={Uri.EscapeDataString(string.Join(',', forbiddenTags))}";

		HttpResponseMessage httpResponseMessage = await _HttpClient.GetAsync(url);
		
		Stream responseStream = await httpResponseMessage.Content.ReadAsStreamAsync();
		GetLevelsResponse? getLevelsResponse = await JsonSerializer.DeserializeAsync<GetLevelsResponse>(
			responseStream, JsonSerializerOptions.Web);

		await FilesQueried.InvokeAsync(getLevelsResponse?.Levels ?? []);
	}

	private List<string> GetTagsByState(TagFilterState tagFilterState)
	{
		IEnumerable<string> parentGroupTags = _FilterGroups
			.OfType<ParentFilterGroup>()
			.SelectMany(parentFilterGroup => parentFilterGroup.SubFilterGroups
				.SelectMany(group => group.TagFilters
					.Where(tagFilter => tagFilter.State == tagFilterState)))
			.Select(tagFilter => tagFilter.Tag);

		IEnumerable<string> groupTags = _FilterGroups
			.OfType<FilterGroup>()
			.SelectMany(filterGroup => filterGroup.TagFilters
				.Where(tagFilter => tagFilter.State == tagFilterState))
			.Select(tagFilter => tagFilter.Tag);

		return parentGroupTags.Concat(groupTags).ToList();
	}

}