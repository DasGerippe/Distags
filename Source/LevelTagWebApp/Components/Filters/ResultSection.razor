@using LevelTagApi.Dtos
@using System.Linq

<div class="table-responsive">
	<table class="table table-striped table-hover align-middle">
		<thead class="thead-light">
			<tr>
				<th style="width:1%; white-space:nowrap; text-align:center;"></th>
				<th>Name</th>
				<th>Creator</th>
				<th style="text-align:center;">Created On</th>
				<th style="text-align:center;">Updated On</th>
				<th style="text-align:center;"></th>
				<th style="text-align:center;"></th>
			</tr>
		</thead>
		<tbody>
			@foreach (GetLevelDto level in PagedItems)
			{
				<tr>
					<td style="text-align:center;"><img src="@level.IconUrl" alt="Icon" style="max-height:40px;" /></td>
					<td>@level.Name</td>
					<td>@level.CreatorName</td>
					<td style="text-align:center;">@level.CreatedOn.ToString("d")</td>
					<td style="text-align:center;">@level.UpdatedOn.ToString("d")</td>
					<td style="text-align:center;">
						<a href="/level/@level.Id">
							<svg style="color: #080808; width: 2rem; height: 2rem;">
								<use href="icons.svg#tags-solid"/>
							</svg>
						</a>
					</td>
					<td style="text-align:center;">
						<a href="https://steamcommunity.com/sharedfiles/filedetails/?id=@level.Id">
							<svg style="color: #1e3050; width: 2rem; height: 2rem;">
								<use href="icons.svg#steam-solid"/>
							</svg>
						</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>

@if (EnablePaging && TotalPages > 1)
{
	<nav>
		<ul class="pagination">
			<li class="page-item @(CurrentPage == 1 ? "disabled" : "")"><a class="page-link" href="#" @onclick="(() => GoToPage(CurrentPage - 1))">Zurück</a></li>
			@for (int p = 1; p <= TotalPages; p++)
			{
				<li class="page-item @(p == CurrentPage ? "active" : "")"><a class="page-link" href="#" @onclick="(() => GoToPage(p))">@p</a></li>
			}
			<li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")"><a class="page-link" href="#" @onclick="(() => GoToPage(CurrentPage + 1))">Weiter</a></li>
		</ul>
	</nav>
}

@code {

	[Parameter]
	public IEnumerable<GetLevelDto> Levels { get; set; } = [];

	[Parameter]
	public bool EnablePaging { get; set; } = false;

	[Parameter]
	public int PageSize { get; set; } = 10;

	private int CurrentPage { get; set; } = 1;

	private IEnumerable<GetLevelDto> PagedItems => EnablePaging
		? (Levels ?? []).Skip((CurrentPage - 1) * PageSize).Take(PageSize)
		: (Levels ?? []);

	private int TotalPages => EnablePaging ? (int)Math.Ceiling((double)(Levels?.Count() ?? 0) / PageSize) : 1;

	private void GoToPage(int p)
	{
		if (p < 1 || p > TotalPages) return;
		CurrentPage = p;
	}

}
