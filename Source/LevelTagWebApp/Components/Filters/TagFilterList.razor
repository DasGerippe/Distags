@using LevelTagWebApp.Components.Inputs
@using LevelTagWebApp.Filters
@using LevelTagWebApp.Services

@foreach (TagFilter tagFilter in TagFilters)
{
	<IconCheckbox TState="TagFilterState"
	              Label="@tagFilter.Name"
				  Logic="CheckboxLogicProvider.GetCheckboxLogic(FilterGroupType)"
				  IconProvider="CheckboxIconProvider"
	              @bind-State="tagFilter.State"/>
}

@code {
	
	[Parameter]
	public FilterGroupType FilterGroupType { get; set; }

	[Parameter]
	public IReadOnlyList<TagFilter> TagFilters { get; set; } = [];

	[CascadingParameter]
	public required TagFilterCheckboxLogicProvider CheckboxLogicProvider { get; set; }

	[CascadingParameter]
	public required TagFilterStateIconProvider CheckboxIconProvider { get; set; }

}