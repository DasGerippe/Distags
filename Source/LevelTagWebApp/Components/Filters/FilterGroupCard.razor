@using LevelTagWebApp.Filters
<div class="card h-100 shadow">

	<div class="card-header bg-light fw-bold">
		@FilterGroupBase.Name
	</div>

	<div class="card-body overflow-auto" style="height: 280px;">
		@switch (FilterGroupBase)
		{
			case FilterGroup filterGroup:
				<TagFilterList FilterGroupType="filterGroup.FilterGroupType"
				               TagFilters="filterGroup.TagFilters" />
				break;

			case ParentFilterGroup parentFilterGroup:
				@foreach (FilterGroup subFilterGroup in parentFilterGroup.SubFilterGroups)
				{
					<div class="mb-3">
						<div class="fw-semibold text-muted mb-1">@subFilterGroup.Name</div>
						<TagFilterList FilterGroupType="subFilterGroup.FilterGroupType"
						               TagFilters="subFilterGroup.TagFilters" />
					</div>
				}
				break;
		}
	</div>

</div>

@code {

	[Parameter]
	public required FilterGroupBase FilterGroupBase { get; set; }

}
