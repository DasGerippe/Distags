@page "/level/{levelId:long}"
@rendermode InteractiveServer

@using LevelTagApi.Dtos
@using LevelTagWebApp.Components.Inputs
@using LevelTagWebApp.Services
@using Microsoft.AspNetCore.SignalR.Client
@using System.Net

@implements IAsyncDisposable
@inject LevelTagApiClient LevelTagApi

@if (_IsLoadingData)
{
	<div class="d-flex justify-content-center align-items-center">
		<div class="spinner-border" style="width: 4rem; height: 4rem;" role="status">
			<span class="sr-only">Loading level...</span>
		</div>
	</div>
	return;
}

@if (_LevelDto == null)
{
	<div class="d-flex flex-column align-items-center text-center">
		<h1 class="display-4 fw-bold text-danger">404</h1>
		<p class="text-danger-emphasis">Could not find level with ID @LevelId.</p>
	</div>
	return;
}

<LevelHeroSection Level="_LevelDto" />

<LoginBanner/>

<div class="container-fluid content">
	<div class="row">
		@foreach (TagGroupDto tagGroup in _TagTree!)
		{
			<TagGroupColumnCard Title="@tagGroup.Name">
				@{
					bool isFirst = true;
					int? lastExclusivity = null;
					foreach (TagDto tag in tagGroup.Tags)
					{
						if (!isFirst && tag.Exclusivity != lastExclusivity)
						{
							<div class="my-2"></div>
						}

						<AsyncIconCheckbox TState="bool"
										   Label="@tag.DisplayName"
										   @bind-State="_TagStates[tag.Name].State"
										   AsyncOperation="state => TryChangeTagState(tag.Name, state)"
										   IconProvider="_CheckboxIconProvider" />

						lastExclusivity = tag.Exclusivity;
						isFirst = false;
					}
				}
			</TagGroupColumnCard>
		}
	</div>
</div>

@code {

	private bool _IsLoadingData = true;

	private LevelDto? _LevelDto;
	private List<TagGroupDto>? _TagTree;

	private readonly ICheckboxIconProvider<bool> _CheckboxIconProvider = new BoolCheckboxIconProvider();

	private readonly Dictionary<string, TagState> _TagStates = new Dictionary<string, TagState>();

	private HubConnection? _LevelHubConnection;

	[Parameter]
	public long LevelId { get; set; }

	protected override async Task OnInitializedAsync()
	{
		try
		{
			_LevelDto = await LevelTagApi.GetLevelAsync(LevelId);
		}
		catch (HttpRequestException httpRequestException) when (httpRequestException.StatusCode == HttpStatusCode.NotFound)
		{
			// This page will handle invalid level IDs.
			_IsLoadingData = false;
			return;
		}

		_TagTree = await LevelTagApi.GetTagTreeAsync();
		InitializeTagStates();

		await SetUpLevelHubConnection();

		_IsLoadingData = false;
	}

	private void InitializeTagStates()
	{
		if (_LevelDto == null || _TagTree == null)
			return;

		foreach (TagDto tag in _TagTree.SelectMany(tagGroup => tagGroup.Tags))
		{
			_TagStates[tag.Name] = new TagState
			{
				State = _LevelDto.Tags.Contains(tag.Name),
			};
		}
	}

	private async Task SetUpLevelHubConnection()
	{
		_LevelHubConnection = new HubConnectionBuilder()
			.WithUrl("https://localhost:7159/levelHub")
			.WithAutomaticReconnect()
			.Build();

		_LevelHubConnection.On<string>("TagAdded", tagName =>
		{
			_TagStates[tagName].State = true;
			InvokeAsync(StateHasChanged);
		});

		_LevelHubConnection.On<string>("TagRemoved", tagName =>
		{
			_TagStates[tagName].State = false;
			InvokeAsync(StateHasChanged);
		});

		await _LevelHubConnection.StartAsync();
		await _LevelHubConnection.InvokeAsync("JoinLevelGroup", _LevelDto!.Id);
	}

	private async Task TryChangeTagState(string tag, bool state)
	{
		if (state)
			await LevelTagApi.DeleteLevelTag(LevelId, tag);
		else
			await LevelTagApi.PostLevelTag(LevelId, tag);
	}

	public async ValueTask DisposeAsync()
	{
		if (_LevelHubConnection != null)
		{
			await _LevelHubConnection.DisposeAsync();
		}
	}

	private class TagState
	{
		public bool State { get; set; }
	}

}