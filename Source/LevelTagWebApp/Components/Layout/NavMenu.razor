@using LevelTagApi.Dtos
@using LevelTagWebApp.Security
@using LevelTagWebApp.Services
@using Microsoft.AspNetCore.WebUtilities

@rendermode InteractiveServer

@inject NavigationManager NavigationManager
@inject LevelTagApiClient LevelTagApi
@inject IUserInfoProvider UserInfoProvider

<nav class="navbar navbar-expand-md shadow">
	<div class="container-fluid content">
		<!-- Brand -->
		<a class="navbar-brand" href="">Project T</a>

		<!-- Menu Button -->
		<button class="navbar-toggler" type="button"
				data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar"
				aria-controls="collapsibleNavbar" aria-expanded="false" aria-label="Toggle Navigation">
			<span class="navbar-toggler-icon"></span>
		</button>

		<!-- Collapsible NavBar -->
		<div id="collapsibleNavbar" class="navbar-collapse collapse justify-content-center">
			<!-- Navigation Links -->
			<ul class="navbar-nav mx-auto mb-2 mb-md-0">
				<li class="nav-item">
					<NavLink class="nav-link" href="browse">Browse Levels</NavLink>
				</li>
				<li class="nav-item">
					<NavLink class="nav-link" href="tags">Tag Glossary</NavLink>
				</li>
				<li class="nav-item">
					<NavLink class="nav-link" href="contributors">Contributors</NavLink>
				</li>
			</ul>

			<!-- Profile Section -->
			<ul class="navbar-nav">
				@if (_UserInfo == null)
				{
					<!-- Steam Login Button -->
					<li class="nav-item">
						<a href="@LevelTagApi.GetSteamLoginEndpoint(NavigationManager.Uri)">
							<img src="steam_sign_in_small.png" alt="Sign in through Steam" />
						</a>
					</li>
				}
				else
				{
					<!-- User Profile Dropdown -->
					<li class="nav-item dropdown">
						<a id="userDropdown" class="nav-link dropdown-toggle d-flex align-items-center"
						   href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
							@if (_UserInfo.SteamAvatarHash == null)
							{
								<svg style="width: 2rem; height: 2rem;"><use href="icons.svg#user-solid" /></svg>
							}
							else
							{
								<img src="https://avatars.steamstatic.com/@(_UserInfo.SteamAvatarHash).jpg" alt="User Avatar" />
							}
							<span class="ps-2">@(_UserInfo.SteamName ?? "Profile")</span>
						</a>
						<ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
							<li><a class="dropdown-item" href="profile">Profile</a></li>
							<li><hr class="dropdown-divider" /></li>
							<li><button class="dropdown-item" @onclick="_ => Logout(false)">Logout</button></li>
							<li><button class="dropdown-item" @onclick="_ => Logout(true)">Logout everywhere</button></li>
						</ul>
					</li>
				}
			</ul>
		</div>
	</div>
</nav>

@code {

	private UserDto? _UserInfo;

	protected override async Task OnInitializedAsync()
	{
		_UserInfo = await UserInfoProvider.GetUserInfoAsync();
	}

	private void Logout(bool logoutEverywhere)
	{
		string logoutValue = logoutEverywhere ? Constants.LogoutAllQueryParameterValue : string.Empty;
		string logoutUrl = QueryHelpers.AddQueryString(NavigationManager.Uri, Constants.LogoutQueryParameterName, logoutValue);
		NavigationManager.NavigateTo(logoutUrl, true);
	}

}
