@using LevelTagApi.Dtos
@using LevelTagApi.Dtos.Contributions

<div class="d-flex align-items-center column-gap-2 overflow-hidden">
    <svg class="flex-shrink-0" style="width:1.5rem; height:1.5rem;"><use href="icons.svg#tag-solid" /></svg>
    <div class="d-flex flex-column overflow-hidden">
        @foreach (ChangeDto tagChange in Changes)
        {
            <div class="d-flex column-gap-1 overflow-hidden">
                <svg class="flex-shrink-0" style="width:1.5rem; height:1.5rem;">
                    <use href="icons.svg#@GetActionIconId(tagChange.Action)"/>
                </svg>
                <span class="text-truncate">@tagChange.TagName</span>
            </div>
        }
    </div>
</div>

@code {
    
    [Parameter]
    public required List<ChangeDto> Changes { get; set; }

    private string GetActionIconId(TagAction action)
    {
        return action switch
        {
            TagAction.Add => "plus-solid",
            TagAction.Remove => "minus-solid",
            _ => throw new ArgumentOutOfRangeException(nameof(action), action, null),
        };
    }

}