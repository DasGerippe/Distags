@using LevelTagApi.Dtos.Contribution

<div class="d-flex column-gap-2 align-items-center overflow-hidden">
    @if (User is { IsAnonymous: false, SteamAvatarHash: not null })
    {
        <img class="rounded-5" src="https://avatars.steamstatic.com/@(User.SteamAvatarHash).jpg" alt="Contributor Avatar" />
    }
    else if (User != null || App == null)
    {
        <svg style="width: 2rem; height: 2rem;"><use href="icons.svg#user-solid" /></svg>
    }
    else
    {
        <svg style="width: 2rem; height: 2rem;"><use href="icons.svg#microchip-solid" /></svg>
    }
    
    <span class="text-truncate @GetContributorNameClass()">@GetContributorName()</span>
</div>

@code {

    [Parameter]
    public required UserDto? User { get; set; }

    [Parameter]
    public required AppDto? App { get; set; }

    [Parameter]
    public bool ShowSteamId { get; set; }

    [Parameter]
    public bool IgnoreAnonymity { get; set; }

    private string GetContributorNameClass()
    {
        if (User != null && (User.IsAnonymous || User.SteamName == null))
            return "fst-italic text-muted";

        if (App != null)
            return "fst-italic";

        return string.Empty;
    }

    private string GetContributorName()
    {
        if (User != null)
        {
            return !IgnoreAnonymity && User.IsAnonymous
                ? Resource.Contributor_AnonymousUserName
                : User.SteamName ?? Resource.Contributor_UnknownUserName;
        }

        if (App != null)
            return App.Name;

        return Resource.Contributor_UnknownUserName;
    }

}