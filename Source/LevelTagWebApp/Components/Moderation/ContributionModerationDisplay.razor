@using LevelTagApi.Dtos
@using LevelTagWebApp.Components.Dialogs
@using LevelTagWebApp.Components.Level
@using LevelTagWebApp.Services

@inject IDialogService DialogService

<div class="row border border-1 border-opacity-25 rounded-3 shadow mx-0 py-2 @GetContainerClass()">
	<!-- Level -->
	<div class="col-12 col-md-4">
		<LevelDisplay Level="Contribution.Level" />
	</div>

	<!-- Tag -->
	<div class="col-12 col-md-3 d-flex align-items-center">
		<button class="btn" @onclick="OnRevertContributionClicked">
			<svg class="flex-shrink-0" style="width:1.5rem; height:1.5rem;"><use href="icons.svg#rotate-left-solid" /></svg>
		</button>
		<svg class="flex-shrink-0" style="width:1.5rem; height:1.5rem;"><use href="icons.svg#@GetActionIconId()" /></svg>
		<svg class="flex-shrink-0" style="width:1.5rem; height:1.5rem;"><use href="icons.svg#tag-solid" /></svg>
		<span class="ps-1">@Contribution.Tag.DisplayName</span>
	</div>

	<!-- Contributor -->
	<div class="col-6 col-md-3 d-flex align-items-center">
		<button class="btn" @onclick="OnBanUserButtonClicked">
			<svg style="width:1.5rem; height:1.5rem; color: @GetBanUserIconColor();"><use href="icons.svg#ban-solid" /></svg>
		</button>
		<ContributorDisplay Contributor="Contribution.Contributor" ShowSteamId="true" IgnoreAnonymity="true" />
	</div>

	<!-- Contribution Date -->
	<div class="col-6 col-md-2 d-flex align-items-center justify-content-end justify-content-md-start">
		<ElapsedTimeDisplay class="text-muted" Timestamp="Contribution.ContributedOn" />
	</div>
</div>

@code {

	[Parameter]
	public required ContributionDto Contribution { get; set; }

	private string GetContainerClass()
	{
		return Contribution.Action switch
		{
			ContributionAction.TagAdded => "bg-success-subtle border-success",
			ContributionAction.TagRemoved => "bg-danger-subtle border-danger",
			_ => throw new InvalidOperationException(),
		};
	}

	private string GetActionIconId()
	{
		return Contribution.Action switch
		{
			ContributionAction.TagAdded => "plus-solid",
			ContributionAction.TagRemoved => "minus-solid",
			_ => throw new InvalidOperationException(),
		};
	}

	private string GetBanUserIconColor()
	{
		return Contribution.Contributor switch
		{
			ContributorUserDto { SteamId: not null } => "darkred",
			_ => "#AAA",
		};
	}

	private async Task OnBanUserButtonClicked()
	{
		if (Contribution.Contributor is ContributorUserDto { SteamId: not null } user)
		{
			BanUserDialog? banUserDialog = DialogService.Get<BanUserDialog>();
			if (banUserDialog != null)
				await banUserDialog.ShowAsync(user.SteamId.Value, user.SteamName);
		}
	}

	private async Task OnRevertContributionClicked()
	{
		RevertContributionsDialog? revertContributionsDialog = DialogService.Get<RevertContributionsDialog>();
		if (revertContributionsDialog != null)
			await revertContributionsDialog.ShowAsync(Contribution);
	}

}