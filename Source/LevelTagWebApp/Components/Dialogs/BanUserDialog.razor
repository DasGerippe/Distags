@using LevelTagApi.Dtos
@using LevelTagWebApp.Services

@implements IAsyncDisposable

@inject IJSRuntime JsRuntime
@inject LevelTagApiClient LevelTagApi

<div class="modal fade" id="@ModalId" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Ban User</h5>
				<button class="btn-close" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body">
				<form>
					<label for="banUserSteamIdInput" class="col-form-label">User Steam ID:</label>
					<input id="banUserSteamIdInput" class="form-control" value="@_SteamId" disabled readonly />

					<label for="banUserSteamNameInput" class="col-form-label">User Steam Name:</label>
					<input id="banUserSteamNameInput" class="form-control" value="@_SteamName" disabled readonly />

					<label for="banUserReasonInput" class="col-form-label">Ban Reason:</label>
					<textarea id="banUserReasonInput" class="form-control" @bind="_Reason"></textarea>
				</form>
			</div>
			<div class="modal-footer">
				<button class="btn btn-primary" @onclick="SubmitUserBan">Submit Ban</button>
			</div>
		</div>
	</div>
</div>

@code {

	private const string ModalId = "banUserModal";

	private IJSObjectReference? _BootstrapModalModule;

	private long? _SteamId;
	private string? _SteamName;
	private string? _Reason;

	private bool _Disposed;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			_BootstrapModalModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/bootstrap-modal.js");
		}
	}

	public async Task ShowAsync(long steamId, string? steamName)
	{
		_SteamId = steamId;
		_SteamName = steamName;
		StateHasChanged();

		await _BootstrapModalModule!.InvokeVoidAsync("showModal", $"#{ModalId}");
	}

	public async Task HideAsync()
	{
		await _BootstrapModalModule!.InvokeVoidAsync("hideModal", $"#{ModalId}");
	}

	private async Task SubmitUserBan()
	{
		if (_SteamId == null)
			return;

		CreateUserBanDto createUserBanDto = new CreateUserBanDto
		{
			SteamId = _SteamId!.Value,
			Reason = _Reason,
		};
		await LevelTagApi.PostUserBan(createUserBanDto);

		await HideAsync();
	}

	public async ValueTask DisposeAsync()
	{
		if (_Disposed)
			return;

		if (_BootstrapModalModule != null)
		{
			try
			{
				await _BootstrapModalModule.DisposeAsync();
			}
			catch (JSDisconnectedException) { }
		}

		_Disposed = true;
	}

}