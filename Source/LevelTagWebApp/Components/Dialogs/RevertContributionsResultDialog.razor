@using LevelTagApi.Dtos

@inherits DialogBase

<Dialog Id="@ModalId">
	<Header>
		<h5 class="modal-title">Revert Contributions Result</h5>
		<button class="btn-close" data-bs-dismiss="modal"></button>
	</Header>
	<Body>
		<table class="table table-sm table-borderless align-middle">
			<tbody>
				<tr>
					<td>Contributions reverted:</td>
					<td>@_ContributionsReverted</td>
				</tr>
				<tr>
					<td>Collateral contributions reverted:</td>
					<td>@_CollateralContributionsReverted</td>
				</tr>
				<tr>
					<td>LevelTags added:</td>
					<td>@_LevelTagsAdded</td>
				</tr>
				<tr>
					<td>LevelTags removed:</td>
					<td>@_LevelTagsRemoved</td>
				</tr>
			</tbody>
		</table>
	</Body>
	<Footer>
		<button class="btn btn-primary" data-bs-dismiss="modal">Close</button>
	</Footer>
</Dialog>

@code {

	private int _ContributionsReverted;
	private int _CollateralContributionsReverted;
	private int _LevelTagsAdded;
	private int _LevelTagsRemoved;

	protected override string ModalId => "revertContributionsResultModal";

	public async ValueTask ShowAsync(RevertContributionsResponse response)
	{
		_ContributionsReverted = response.ContributionsReverted;
		_CollateralContributionsReverted = response.CollateralContributionsReverted;
		_LevelTagsAdded = response.LevelTagsAdded;
		_LevelTagsRemoved = response.LevelTagsRemoved;
		StateHasChanged();

		await ShowAsync();
	}

	public new ValueTask HideAsync()
	{
		return base.HideAsync();
	}

}