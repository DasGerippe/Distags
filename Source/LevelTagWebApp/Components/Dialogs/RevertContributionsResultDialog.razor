@inherits DialogBase

<Dialog Id="@ModalId">
    <Header>
        <h5 class="modal-title">Revert Contributions Result</h5>
        <button class="btn-close" data-bs-dismiss="modal"></button>
    </Header>
    <Body>
        @if (_ResponseMessage?.IsSuccessStatusCode == true)
        {
            <div class="text-center">Success!</div>
        }
        else
        {
            <div>Status Code: @_ResponseMessage?.StatusCode</div>
            <div>@_Content</div>
        }
    </Body>
    <Footer>
        <button class="btn btn-primary" data-bs-dismiss="modal">Close</button>
    </Footer>
</Dialog>

@code {

    private HttpResponseMessage? _ResponseMessage;
    private string? _Content;

    protected override string ModalId => "revertContributionsResultModal";

    public async ValueTask ShowAsync(HttpResponseMessage responseMessage)
    {
        _ResponseMessage = responseMessage;
        _Content = await _ResponseMessage.Content.ReadAsStringAsync();
        StateHasChanged();

        await ShowAsync();
    }

    public new ValueTask HideAsync()
    {
        return base.HideAsync();
    }

}