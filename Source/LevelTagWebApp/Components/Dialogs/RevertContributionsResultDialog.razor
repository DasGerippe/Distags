@using LevelTagApi.Dtos

@implements IAsyncDisposable

@inject IJSRuntime JsRuntime

<div class="modal fade" id="@ModalId" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Revert Contributions Result</h5>
				<button class="btn-close" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body">
				<table class="table table-sm table-borderless align-middle">
					<tbody>
						<tr>
							<td>Contributions reverted:</td>
							<td>@_ContributionsReverted</td>
						</tr>
						<tr>
							<td>Collateral contributions reverted:</td>
							<td>@_CollateralContributionsReverted</td>
						</tr>
						<tr>
							<td>LevelTags added:</td>
							<td>@_LevelTagsAdded</td>
						</tr>
						<tr>
							<td>LevelTags removed:</td>
							<td>@_LevelTagsRemoved</td>
						</tr>
					</tbody>
				</table>
			</div>
			<div class="modal-footer">
				<button class="btn btn-primary" data-bs-dismiss="modal">Close</button>
			</div>
		</div>
	</div>
</div>

@code {

	private const string ModalId = "revertContributionsResultModal";

	private IJSObjectReference? _BootstrapModalModule;

	private int _ContributionsReverted;
	private int _CollateralContributionsReverted;
	private int _LevelTagsAdded;
	private int _LevelTagsRemoved;

	private bool _Disposed;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			_BootstrapModalModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/bootstrap-modal.js");
		}
	}

	public async Task ShowAsync(RevertContributionsResponse response)
	{
		_ContributionsReverted = response.ContributionsReverted;
		_CollateralContributionsReverted = response.CollateralContributionsReverted;
		_LevelTagsAdded = response.LevelTagsAdded;
		_LevelTagsRemoved = response.LevelTagsRemoved;
		StateHasChanged();

		await _BootstrapModalModule!.InvokeVoidAsync("showModal", $"#{ModalId}");
	}

	public async Task HideAsync()
	{
		await _BootstrapModalModule!.InvokeVoidAsync("hideModal", $"#{ModalId}");
	}

	public async ValueTask DisposeAsync()
	{
		if (_Disposed)
			return;

		if (_BootstrapModalModule != null)
		{
			try
			{
				await _BootstrapModalModule.DisposeAsync();
			}
			catch (JSDisconnectedException) { }
		}

		_Disposed = true;
	}

}