@using LevelTagApi.Dtos

<div class="row border border-1 border-opacity-25 rounded-3 shadow mx-0 py-2 @GetContainerClass(Contribution.Action)">
	<!-- Level -->
	<div class="col-12 col-md-4 d-flex align-items-center">
		<img class="rounded-1" src="@Contribution.Level.IconUrl" alt="Level Image" style="max-height:40px;" />
		<div class="d-flex flex-column text-truncate ps-2">
			<div class="text-truncate mb-0">@Contribution.Level.Name</div>
			<div class="small fw-lighter text-muted">@Contribution.Level.CreatorName</div>
		</div>
	</div>

	<!-- Tag -->
	<div class="col-12 col-md-3 d-flex align-items-center">
		<svg class="flex-shrink-0" style="width:1.5rem; height:1.5rem;"><use href="icons.svg#@GetActionIconId(Contribution.Action)" /></svg>
		<svg class="flex-shrink-0" style="width:1.5rem; height:1.5rem;"><use href="icons.svg#tag-solid" /></svg>
		<span class="ps-1">@Contribution.Tag.DisplayName</span>
	</div>

	<!-- Contributor -->
	<div class="col-6 col-md-3 d-flex align-items-center">
		<ContributorDisplay Contributor="Contribution.Contributor" />
	</div>

	<!-- Contribution Date -->
	<div class="col-6 col-md-2 d-flex align-items-center justify-content-end justify-content-md-start">
		<ElapsedTimeDisplay class="text-muted" Timestamp="Contribution.ContributedOn" />
	</div>
</div>

@code {

	[Parameter]
	public required ContributionDto Contribution { get; set; }

	private string GetContainerClass(ContributionAction action)
	{
		return action switch
		{
			ContributionAction.TagAdded => "bg-success-subtle border-success",
			ContributionAction.TagRemoved => "bg-danger-subtle border-danger",
			_ => throw new ArgumentOutOfRangeException(nameof(action), action, null),
		};
	}

	private string GetActionIconId(ContributionAction action)
	{
		return action switch
		{
			ContributionAction.TagAdded => "plus-solid",
			ContributionAction.TagRemoved => "minus-solid",
			_ => throw new ArgumentOutOfRangeException(nameof(action), action, null),
		};
	}

}