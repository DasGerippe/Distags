<Project>

  <!--
    Shared post-build step for all AutoTagging.* plugin projects.

    AutoTaggerRunner needs plugins and loads them via Assembly.LoadFrom. The dependencies
    and assets (like config/import files) have to be placed next to the dll. Assemblies coming
    from ProjectReference are deliberately not copied, the runner already ships them in its own
    output and can resolve them from there, additional copying is bad...

    Favor msbuild copy task over xcopy (robocopy, blablacopy, ...) for OS compatibility

    Paths are anchored at the directory holding LevelTagging.sln, not at this file's own location
    and not at SolutionDir. SolutionDir is only defined when building through the .sln, so building
    a plugin project on its own would copy the DLL to a wrong, working-directory-relative location.
    Anchoring at the .sln instead of MSBuildThisFileDirectory keeps this file movable - relocating
    it does not change where plugins end up. That works best for me. Lets talk about it
    if u have some trouble.
  -->

  <PropertyGroup>
    <DistagsSolutionRoot>$([MSBuild]::EnsureTrailingSlash($([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory), 'LevelTagging.sln'))))</DistagsSolutionRoot>
    <AutoTaggerRunnerPluginsDir>$(DistagsSolutionRoot)AutoTaggerRunner/bin/$(Configuration)/$(TargetFramework)/Plugins/</AutoTaggerRunnerPluginsDir>
  </PropertyGroup>

  <Target Name="CopyToAutoTaggerRunnerPlugins" AfterTargets="Build">
    <ItemGroup>
      <PluginSharedOutput Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference')->'%(Filename)%(Extension)')" />

      <PluginOutputFiles Include="$(TargetDir)**/*.*" />
      <PluginOutputFiles Remove="@(PluginSharedOutput->'$(TargetDir)%(Identity)')" />
    </ItemGroup>

    <Copy SourceFiles="@(PluginOutputFiles)"
          DestinationFolder="$(AutoTaggerRunnerPluginsDir)%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
