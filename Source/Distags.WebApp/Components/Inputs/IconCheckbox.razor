@using Distags.WebApp.Services

@typeparam TState

<div class="custom-checkbox d-flex align-items-start gap-2"
	 @onclick="SetNextState">
	<svg class="icon-wrapper flex-shrink-0 @IconProvider.GetIconClass(State)">
		<use href="icons.svg#@(IconProvider.GetIconId(State))" />
	</svg>
	<span class="form-check-label"
	      style="min-width: 0">
		@Label
	</span>
</div>

@code {

	[Parameter]
	public string? Label { get; set; }

	[Parameter]
	public TState State { get; set; } = default!;

	[Parameter]
	public EventCallback<TState> StateChanged { get; set; }

	[Parameter]
	public required ICheckboxLogic<TState> Logic { get; set; }

	[Parameter]
	public required ICheckboxIconProvider<TState> IconProvider { get; set; }

	private async Task SetNextState()
	{
		State = Logic.GetNextState(State);
		await StateChanged.InvokeAsync(State);
	}

}