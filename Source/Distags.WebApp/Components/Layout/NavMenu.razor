@using Constants = Distags.WebApp.Constants;
@using Distags.Api.Contracts.Users
@using Distags.WebApp.DistagsApi
@using Microsoft.AspNetCore.WebUtilities

@inject NavigationManager NavigationManager
@inject DistagsApiClient DistagsApi

<nav class="navbar navbar-expand-md shadow">
    <div class="container-fluid">
        <!-- Brand -->
        <a class="navbar-brand" href="">
            <img class="img-fluid w-100" style="height:30px;" src="Distags_Light.svg"/>
        </a>

        <!-- Menu Button -->
        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar"
                aria-controls="collapsibleNavbar" aria-expanded="false" aria-label="Toggle Navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Collapsible NavBar -->
        <div id="collapsibleNavbar" class="navbar-collapse collapse justify-content-center">
            <!-- Navigation Links -->
            <ul class="navbar-nav mx-auto mb-2 mb-md-0">
                <li class="nav-item">
                    <NavLink class="nav-link" href="browse">@Resource.NavLink_BrowseLevels</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="tags">@Resource.NavLink_TagGlossary</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="contributions">@Resource.NavLink_Contributions</NavLink>
                </li>
                @if (User?.Roles.Contains("Moderator") == true)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="moderation">@Resource.NavLink_Moderation</NavLink>
                    </li>
                }
                @if (User?.Roles.Contains("Administrator") == true)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="admin">@Resource.NavLink_Administration</NavLink>
                    </li>
                }
            </ul>

            <!-- Profile Section -->
            <ul class="navbar-nav">
                @if (User == null)
                {
                    <!-- Steam Login Button -->
                    <li class="nav-item">
                        <a href="@DistagsApi.GetSteamLoginEndpoint(NavigationManager.Uri)">
                            <img src="steam_sign_in_small.png" alt="Sign in through Steam" />
                        </a>
                    </li>
                }
                else
                {
                    <!-- User Profile Dropdown -->
                    <li class="nav-item dropdown">
                        <a id="userDropdown" class="nav-link dropdown-toggle d-flex align-items-center"
                           href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            @if (User.SteamAvatarHash == null)
                            {
                                <svg style="width: 2rem; height: 2rem;"><use href="icons.svg#user-solid" /></svg>
                            }
                            else
                            {
                                <img src="https://avatars.steamstatic.com/@(User.SteamAvatarHash).jpg" alt="User Avatar" />
                            }
                            <span class="ps-2">
                                @(string.IsNullOrEmpty(User.SteamName)
                                    ? Resource.ProfileDropdown_FallbackText
                                    : User.SteamName)
                            </span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                            <li><a class="dropdown-item" href="settings">@Resource.ProfileDropdown_Settings</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><button class="dropdown-item" @onclick="_ => Logout(false)">@Resource.ProfileDropdown_Logout</button></li>
                            <li><button class="dropdown-item" @onclick="_ => Logout(true)">@Resource.ProfileDropdown_LogoutEverywhere</button></li>
                        </ul>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

@code {

    [CascadingParameter]
    public UserResponse? User { get; set; }

    private void Logout(bool logoutEverywhere)
    {
        string logoutValue = logoutEverywhere ? Constants.LogoutAllQueryParameterValue : string.Empty;
        string logoutUrl = QueryHelpers.AddQueryString(NavigationManager.Uri, Constants.LogoutQueryParameterName, logoutValue);
        NavigationManager.NavigateTo(logoutUrl, true);
    }

}
