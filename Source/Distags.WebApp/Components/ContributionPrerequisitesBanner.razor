@using Distags.Api.Contracts.Users

@if (string.IsNullOrEmpty(_Text))
    return;

<div class="bg-warning-subtle shadow-sm">
    <div class="container-fluid content">
        <p class="py-2 text-center">
            @_Text
        </p>
    </div>
</div>

@code {

    private string? _Text;

    [CascadingParameter]
    public UserResponse? User { get; set; }

    protected override void OnParametersSet()
    {
        if (User == null)
            _Text = Resource.ContributionPrerequisiteLoginText;
        else if (!User.AcceptsGuidelines)
            _Text = Resource.ContributionPrerequisiteGuidelinesText;
    }

}
