@using Distags.Contracts

<div class="d-flex align-items-center">
    <div class="d-flex align-items-center justify-content-center" style="width:80px; height:45px;">
        <a href="level/@Level.Id">
            <img class="rounded-1 shadow-sm" src="@Level.ImageUrl" alt="Image" style="width:80px; height:45px;"/>
        </a>
    </div>
    <div class="d-flex flex-column text-truncate ps-2">
        <div class="text-truncate">@Level.Name</div>
        <div class="text-truncate text-muted small fw-lighter">@Level.CreatorName</div>
    </div>
</div>

@code {

    [Parameter]
    public required ContributionLevelDto Level { get; set; }

}