@page "/moderation"
@rendermode InteractiveServer

@using Distags.Contracts
@using Distags.WebApp.Components.Contribution
@using Distags.WebApp.Components.Dialogs
@using Distags.WebApp.Security

@inject IUserInfoProvider UserInfoProvider
@inject NavigationManager NavigationManager

<PageTitle>@Resource.PageTitle_Moderation</PageTitle>

<div class="container-fluid content">
    <ContributionModerationList />
</div>

<InfoDialog/>
<BanUserDialog />
<RevertContributionsDialog />
<RevertContributionsResultDialog />

@code {

    private UserDto? _User;

    protected override async Task OnInitializedAsync()
    {
        _User = await UserInfoProvider.GetUserInfoAsync();
        if (_User?.Roles.Contains("Moderator") != true)
        {
            NavigationManager.NotFound();
            return;
        }
    }

}