@page "/moderation"

@using Distags.Api.Contracts.Users
@using Distags.WebApp.Components.Contribution
@using Distags.WebApp.Components.Dialogs

@inject NavigationManager NavigationManager

<PageTitle>@Resource.PageTitle_Moderation</PageTitle>

<div class="container-fluid content">
    <ContributionModerationList />
</div>

<InfoDialog/>
<BanUserDialog />
<RevertContributionsDialog />
<RevertContributionsResultDialog />

@code {

    [CascadingParameter]
    public UserResponse? User { get; set; }

    protected override void OnParametersSet()
    {
        if (User?.Roles.Contains("Moderator") != true)
            NavigationManager.NotFound();
    }

}
