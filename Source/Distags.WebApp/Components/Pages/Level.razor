@page "/level/official/{officialLevelSlug}"
@page "/level/workshop/{workshopLevelId:long}"
@rendermode InteractiveServer

@using Distags.Api.Contracts.Levels
@using Distags.Api.Contracts.Tags
@using Distags.Api.Contracts.Users
@using Distags.Contracts
@using Distags.WebApp.Components.Inputs
@using Distags.WebApp.Components.Level
@using Distags.WebApp.Models
@using Distags.WebApp.Security
@using Distags.WebApp.Services
@using Microsoft.AspNetCore.SignalR.Client
@using System.Net

@implements IAsyncDisposable

@inject DistagsApiClient DistagsApi
@inject TagTreeProvider TagTreeProvider
@inject IUserInfoProvider UserInfoProvider

@if (_IsLoadingData)
{
    <PageTitle>@Resource.PageTitle_Level_Loading</PageTitle>

    <div class="d-flex justify-content-center align-items-center">
        <div class="spinner-border" style="width: 4rem; height: 4rem;" role="status">
            <span class="visually-hidden">Loading level...</span>
        </div>
    </div>
    return;
}

@if (_Level == null)
{
    <PageTitle>@Resource.PageTitle_Level_Unknown</PageTitle>

    <div class="d-flex flex-column align-items-center text-center">
        <h1 class="display-4 fw-bold text-danger">404</h1>
        <p class="text-danger-emphasis">@GetLevelNullErrorText()</p>
    </div>
    return;
}

<PageTitle>@string.Format(Resource.PageTitle_Level, _Level.Name)</PageTitle>

<LevelHero Level="_Level" />

<ContributionPrerequisitesBanner/>

<div class="container-fluid content-wide">
    <div class="row">
        @foreach (DisplayGroupWithTags tagGroup in _TagTree!)
        {
            <TagGroupColumnCard Title="@tagGroup.DisplayGroup.DisplayName">
                @{
                    bool isFirst = true;
                    string? previousLogicGroupName = null;
                    foreach (TagResponse tag in tagGroup.Tags)
                    {
                        if (!isFirst && tag.LogicGroupName != previousLogicGroupName)
                        {
                            <div class="my-2"></div>
                        }

                        <AsyncIconCheckbox TState="bool"
                                           ReadOnly="_IsReadOnly || tag.IsAutoTag"
                                           Label="@tag.DisplayName"
                                           @bind-State="_TagStates[tag.Name].State"
                                           AsyncOperation="state => TryChangeTagState(tag.Name, state)"
                                           IconProvider="_CheckboxIconProvider" />

                        previousLogicGroupName = tag.LogicGroupName;
                        isFirst = false;
                    }
                }
            </TagGroupColumnCard>
        }
    </div>
</div>

@code {

    private bool _IsLoadingData = true;
    private bool _IsReadOnly;

    private LevelResponse? _Level;
    private IReadOnlyCollection<DisplayGroupWithTags>? _TagTree;

    private readonly ICheckboxIconProvider<bool> _CheckboxIconProvider = new BoolCheckboxIconProvider();

    private readonly Dictionary<string, TagState> _TagStates = new Dictionary<string, TagState>();

    private HubConnection? _LevelHubConnection;

    [Parameter]
    public string? OfficialLevelSlug { get; set; }

    [Parameter]
    public long? WorkshopLevelId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (OfficialLevelSlug != null)
                _Level = await DistagsApi.GetOfficialLevelAsync(OfficialLevelSlug);
            else if (WorkshopLevelId != null)
                _Level = await DistagsApi.GetWorkshopLevelAsync(WorkshopLevelId.Value);
            else
                return;
        }
        catch (HttpRequestException httpRequestException) when (httpRequestException.StatusCode == HttpStatusCode.NotFound)
        {
            // This page will handle invalid slugs or workshop IDs.
            return;
        }
        finally
        {
            _IsLoadingData = false;
        }

        UserResponse? user = await UserInfoProvider.GetUserInfoAsync();
        _IsReadOnly = user?.AcceptsGuidelines != true;

        _TagTree = await TagTreeProvider.GetTagTreeAsync();
        InitializeTagStates();

        _IsLoadingData = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await SetUpLevelHubConnection();
    }

    private void InitializeTagStates()
    {
        if (_Level == null || _TagTree == null)
            return;

        foreach (TagResponse tag in _TagTree.SelectMany(tagGroup => tagGroup.Tags))
        {
            _TagStates[tag.Name] = new TagState
            {
                State = _Level.Tags!.Contains(tag.Name),
            };
        }
    }

    private async Task SetUpLevelHubConnection()
    {
        _LevelHubConnection = new HubConnectionBuilder()
            .WithUrl(DistagsApi.LevelHubEndpoint)
            .WithAutomaticReconnect()
            .Build();

        _LevelHubConnection.On<List<TagChangeResponse>>("TagsChanged", tagChanges =>
        {
            foreach (TagChangeResponse change in tagChanges)
            {
                bool state = change.Action == TagChangeAction.Add;
                _TagStates[change.TagName].State = state;
            }
            InvokeAsync(StateHasChanged);
        });

        await _LevelHubConnection.StartAsync();
        await _LevelHubConnection.InvokeAsync("JoinLevelGroup", _Level!.Key);
    }

    private async Task TryChangeTagState(string tagName, bool state)
    {
        if (state)
            await DistagsApi.DeleteLevelTagAsync(_Level!, tagName);
        else
            await DistagsApi.PutLevelTagAsync(_Level!, tagName);
    }

    private string GetLevelNullErrorText()
    {
        if (OfficialLevelSlug != null)
            return $"Could not find official level {OfficialLevelSlug}.";

        if (WorkshopLevelId != null)
            return $"Could not find workshop level with ID {WorkshopLevelId}.";

        return "How did you even get here?";
    }

    public async ValueTask DisposeAsync()
    {
        if (_LevelHubConnection != null)
            await _LevelHubConnection.DisposeAsync();
    }

    private class TagState
    {
        public bool State { get; set; }
    }

}
