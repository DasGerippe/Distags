@page "/level/official/{officialSlug}"
@page "/level/workshop/{workshopId:long}"

@using Distags.Api.Contracts.Levels
@using Distags.Api.Contracts.Tags
@using Distags.Api.Contracts.Users
@using Distags.Contracts
@using Distags.WebApp.Components.Inputs
@using Distags.WebApp.Components.Level
@using Distags.WebApp.DistagsApi
@using Distags.WebApp.Models
@using Distags.WebApp.Services
@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.SignalR.Client
@using System.Net

@implements IAsyncDisposable

@inject DistagsApiClient DistagsApi
@inject TagTreeProvider TagTreeProvider

@if (_IsLoading)
{
    <PageTitle>@Resource.PageTitle_Level_Loading</PageTitle>
    <div class="d-flex align-items-center justify-content-center h-100">
        <div class="spinner-border" style="width: 4rem; height: 4rem;" role="status">
            <span class="visually-hidden">@Resource.Level_Loading</span>
        </div>
    </div>
    return;
}

@if (ProblemDetails != null)
{
    <PageTitle>@Resource.PageTitle_Level_Error</PageTitle>
    <div class="container-fluid content-narrow">
        <div class="d-flex flex-column align-items-center p-4">
            <h3 class="text-danger"><strong>@Resource.Level_NotLoaded</strong></h3>
            <ProblemDetailsDisplay ProblemDetails="ProblemDetails" />
        </div>
    </div>
    return;
}

@if (Level == null)
{
    <PageTitle>@Resource.PageTitle_Level_Unknown</PageTitle>
    return;
}

<PageTitle>@string.Format(Resource.PageTitle_Level, Level.Name)</PageTitle>

<LevelHero Level="Level" />

<ContributionPrerequisitesBanner />

<div class="container-fluid content-wide">
    <div class="row">
        @foreach (DisplayGroupWithTags tagGroup in _TagTree)
        {
            <TagGroupColumnCard Title="@tagGroup.DisplayGroup.DisplayName">
                @{
                    bool isFirst = true;
                    string? previousLogicGroupName = null;
                    foreach (TagResponse tag in tagGroup.Tags)
                    {
                        if (!isFirst && tag.LogicGroupName != previousLogicGroupName)
                        {
                            <div class="my-2"></div>
                        }

                        <AsyncIconCheckbox TState="bool"
                                           ReadOnly="_IsReadOnly || tag.IsAutoTag"
                                           Label="@tag.DisplayName"
                                           @bind-State="_TagStates[tag.Name].State"
                                           AsyncOperation="state => ChangeTagState(tag.Name, state)"
                                           IconProvider="_CheckboxIconProvider" />

                        previousLogicGroupName = tag.LogicGroupName;
                        isFirst = false;
                    }
                }
            </TagGroupColumnCard>
        }
    </div>
</div>

@code {

    private bool _IsLoading = true;

    private readonly ICheckboxIconProvider<bool> _CheckboxIconProvider = new BoolCheckboxIconProvider();

    private bool _IsReadOnly;
    private IReadOnlyCollection<DisplayGroupWithTags> _TagTree = [];
    private readonly Dictionary<string, TagState> _TagStates = [];

    private HubConnection? _LevelHubConnection;
    private string? _CurrentLevelHubGroupName;

    [Parameter]
    public string? OfficialSlug { get; set; }

    [Parameter]
    public long? WorkshopId { get; set; }

    [PersistentState]
    public LevelResponse? Level { get; set; }

    [PersistentState]
    public ProblemDetails? ProblemDetails { get; set; }

    [CascadingParameter]
    public UserResponse? User { get; set; }

    protected override async Task OnInitializedAsync()
    {
        List<Task> tasks =
        [
            InitializeTagTreeAsync(),
        ];

        if (RendererInfo.IsInteractive)
        {
            SetUpLevelHubConnection();
            tasks.Add(_LevelHubConnection!.StartAsync());
        }

        await Task.WhenAll(tasks);
    }

    private async Task InitializeTagTreeAsync()
    {
        _TagTree = await TagTreeProvider.GetTagTreeAsync();
    }

    protected override void OnParametersSet()
    {
        _IsReadOnly = User?.AcceptsGuidelines != true;
    }

    protected override async Task OnParametersSetAsync()
    {
        _IsLoading = true;
        try
        {
            if (OfficialSlug != null && OfficialSlug != (Level as OfficialLevelResponse)?.Slug)
                SetValuesFromApiResponse(await DistagsApi.GetOfficialLevelAsync(OfficialSlug));
            else if (WorkshopId != null && WorkshopId != (Level as WorkshopLevelResponse)?.WorkshopId)
                SetValuesFromApiResponse(await DistagsApi.GetWorkshopLevelAsync(WorkshopId.Value));

            bool switchGroup = RendererInfo.IsInteractive && _CurrentLevelHubGroupName != Level?.Key;

            if (switchGroup && _CurrentLevelHubGroupName != null)
                await LeaveLevelHubGroup(_CurrentLevelHubGroupName);

            InitializeTagStates();

            if (switchGroup && Level?.Key != null)
                await JoinLevelHubGroup(Level.Key);
        }
        finally
        {
            _IsLoading = false;
        }
    }

    private void SetValuesFromApiResponse<TLevel>(ApiResult<TLevel> apiResult)
        where TLevel : LevelResponse
    {
        Level = apiResult.Value;
        ProblemDetails = apiResult.ProblemDetails;
    }

    private void InitializeTagStates()
    {
        _TagStates.Clear();

        if (Level == null)
            return;

        foreach (TagResponse tag in _TagTree.SelectMany(tagGroup => tagGroup.Tags))
        {
            _TagStates[tag.Name] = new TagState
            {
                State = Level.Tags!.Contains(tag.Name),
            };
        }
    }

    private void SetUpLevelHubConnection()
    {
        _LevelHubConnection = new HubConnectionBuilder()
            .WithUrl(DistagsApi.LevelHubEndpoint)
            .WithAutomaticReconnect()
            .Build();

        _LevelHubConnection.Reconnected += LevelHubConnectionOnReconnected;

        _LevelHubConnection.On<List<TagChangeResponse>>("TagsChanged", tagChanges =>
        {
            foreach (TagChangeResponse change in tagChanges)
            {
                bool state = change.Action == TagChangeAction.Add;
                _TagStates[change.TagName].State = state;
            }
            InvokeAsync(StateHasChanged);
        });
    }

    private Task LevelHubConnectionOnReconnected(string? newConnectionId)
    {
        return Level != null ? JoinLevelHubGroup(Level.Key) : Task.CompletedTask;
    }

    private async Task JoinLevelHubGroup(string groupName)
    {
        await _LevelHubConnection!.InvokeAsync("JoinLevelGroup", groupName);
        _CurrentLevelHubGroupName = groupName;
    }

    private async Task LeaveLevelHubGroup(string groupName)
    {
        await _LevelHubConnection!.InvokeAsync("LeaveLevelGroup", groupName);
        _CurrentLevelHubGroupName = null;
    }

    private async Task ChangeTagState(string tagName, bool state)
    {
        if (state)
        {
            ApiResult apiResult = await DistagsApi.DeleteLevelTagAsync(Level!, tagName);
            if (apiResult.StatusCode == HttpStatusCode.NotFound)
                _TagStates[tagName].State = false;
        }
        else
        {
            ApiResult apiResult = await DistagsApi.PutLevelTagAsync(Level!, tagName);
            if (apiResult.StatusCode == HttpStatusCode.Conflict)
                _TagStates[tagName].State = true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_LevelHubConnection != null)
            await _LevelHubConnection.DisposeAsync();
    }

    private class TagState
    {
        public bool State { get; set; }
    }

}
