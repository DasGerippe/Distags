@page "/tags"

@using Distags.Api.Contracts.DisplayGroups
@using Distags.Api.Contracts.Tags
@using Distags.WebApp.Models
@using Distags.WebApp.Services

@inject TagTreeProvider TagTreeProvider

@if (TagTree == null)
{
    return;
}

<div class="container-fluid content py-4">
    <h1 class="h1 text-center">Tag Glossary</h1>

    <div class="d-flex flex-column gap-3">
        @foreach (DisplayGroupWithTags displayGroupWithTags in TagTree)
        {
            DisplayGroupResponse displayGroup = displayGroupWithTags.DisplayGroup;
            string collapseId = $"{displayGroup.Name}Collapse";

            <div class="accordion">
                <div class="accordion-item">

                    <div class="accordion-header">
                        <button class="accordion-button collapsed"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#@collapseId">
                            <div class="d-flex flex-row justify-content-between align-items-center w-100">
                                <div class="d-flex flex-column">
                                    <div class="fw-bold">@displayGroup.DisplayName</div>
                                    <div>@displayGroup.Description</div>
                                </div>
                                <span class="badge bg-secondary ms-auto me-2">@displayGroupWithTags.Tags.Count</span>
                            </div>
                        </button>
                    </div>

                    <div id="@collapseId"
                         class="accordion-body collapse">
                        <table class="table table-sm m-0">
                            <thead>
                            <tr>
                                <th>Tag</th>
                                <th>Description</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (TagResponse tag in displayGroupWithTags.Tags)
                            {
                                <tr>
                                    <td class="text-wrap text-md-nowrap">@tag.DisplayName</td>
                                    <td>@tag.Description</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        }
    </div>
</div>

@code {

    [PersistentState]
    public IReadOnlyCollection<DisplayGroupWithTags>? TagTree { get; set; }

    protected override async Task OnInitializedAsync()
    {
        TagTree ??= await TagTreeProvider.GetTagTreeAsync();
    }

}
