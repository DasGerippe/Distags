@page "/settings"

@using Distags.Api.Contracts.Guidelines
@using Distags.Api.Contracts.Users
@using Distags.WebApp.DistagsApi
@using Distags.WebApp.Security

@inject IUserInfoProvider UserInfoProvider
@inject DistagsApiClient DistagsApi

<PageTitle>@Resource.PageTitle_Settings</PageTitle>

@if (!_LoggedIn)
    return;

<div class="container-fluid content-narrow py-4">

    <!-- Contribution guidelines -->
    @if (_Guidelines != null)
    {
        <div class="mb-4">
            <h2 class="mb-2">@Resource.Setting_ContributionGuidelines_Title</h2>
            @foreach (GuidelineResponse guideline in _Guidelines.Guidelines)
            {
                <p class="fw-bold mb-0">@guideline.Title</p>
                <p>@guideline.Text</p>
            }

            @if (!_AcceptsGuidelines)
            {
                <button class="btn btn-success" disabled="@(_Guidelines == null)" @onclick="AcceptContributionGuidelinesAsync">
                    @Resource.Setting_ContributionGuidelines_Accept
                </button>
            }
            else
            {
                <p>
                    <svg class="text-success" style="width: 2rem; height: 2rem;"><use href="icons.svg#circle-check-solid" /></svg>
                    @Resource.Setting_ContributionGuidelines_Accepted
                </p>
            }
        </div>
    }

    <!-- Contribution Anonymity -->
    <div class="mb-4">
        <h2 class="mb-2">Contribution Settings</h2>
        <div class="form-check form-switch">
            <input type="checkbox" role="switch" id="anonymousCheckbox" class="form-check-input" checked="@_IsAnonymous"
                   @onchange="OnAnonymousChangedAsync"/>
            <div>
                <label for="anonymousCheckbox" class="form-check-label fw-bold">@Resource.Setting_Anonymous_Title</label>
                <p class="small fw-lighter my-0">
                    @string.Format(Resource.Setting_Anonymous_Text, Resource.Contributor_AnonymousUserName)
                </p>
            </div>
        </div>
    </div>

</div>

@code {

    private bool _LoggedIn;
    private bool _AcceptsGuidelines;
    private bool _IsAnonymous;

    private GuidelinesResponse? _Guidelines;

    protected override async Task OnInitializedAsync()
    {
        UserResponse? user = await UserInfoProvider.GetUserInfoAsync();
        if (user == null)
            return;

        _LoggedIn = true;
        _AcceptsGuidelines = user.AcceptsGuidelines;
        _IsAnonymous = user.IsAnonymous;

        ApiResult<GuidelinesResponse> apiResult = await DistagsApi.GetContributionGuidelinesAsync();
        _Guidelines = apiResult.Value;
    }

    private async Task AcceptContributionGuidelinesAsync()
    {
        PatchUserSettingsRequest request = new PatchUserSettingsRequest { AcceptsGuidelines = true };
        ApiResult apiResult = await DistagsApi.PatchUserSettingsAsync(request);
        if (apiResult.IsSuccess)
            _AcceptsGuidelines = true;
    }

    private async Task OnAnonymousChangedAsync(ChangeEventArgs args)
    {
        if (args.Value is not bool isAnonymous)
            return;

        PatchUserSettingsRequest request = new PatchUserSettingsRequest { IsAnonymous = isAnonymous };
        ApiResult apiResult = await DistagsApi.PatchUserSettingsAsync(request);
        if (apiResult.IsSuccess)
            _IsAnonymous = isAnonymous;
    }

}
