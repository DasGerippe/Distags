@page "/admin"
@rendermode InteractiveServer

@using Distags.Api.Contracts.Configuration
@using Distags.Api.Contracts.Users
@using Distags.WebApp.DistagsApi
@using Distags.WebApp.Security

@inject IUserInfoProvider UserInfoProvider
@inject NavigationManager NavigationManager
@inject DistagsApiClient DistagsApi

<PageTitle>@Resource.PageTitle_Administration</PageTitle>

<div class="container-fluid content-narrow py-4">

    <h2 class="mb-2">@Resource.AdminSetting_GlobalSettings_Title</h2>
    
    <div class="form-check form-switch">
        <input type="checkbox" role="switch" id="maintenanceCheckbox" class="form-check-input" checked="@_MaintenanceActive"
               @onchange="OnMaintenanceChanged"/>
        <div>
            <label for="maintenanceCheckbox" class="form-check-label fw-bold">
                @(_MaintenanceActive
                    ? Resource.AdminSetting_MaintenanceActive_Title
                    : Resource.AdminSetting_MaintenanceInactive_Title)
            </label>
            <p class="small fw-lighter my-0">@Resource.AdminSetting_Maintenance_Text</p>
        </div>
    </div>

</div>

@code {

    private UserResponse? _User;

    private bool _MaintenanceActive;

    protected override async Task OnInitializedAsync()
    {
        _User = await UserInfoProvider.GetUserInfoAsync();
        if (_User?.Roles.Contains("Administrator") != true)
        {
            NavigationManager.NotFound();
            return;
        }

        ApiResult<ConfigurationResponse> apiResult = await DistagsApi.GetApiStateAsync();
        apiResult.EnsureSuccess();
        _MaintenanceActive = apiResult.Value.MaintenanceActive;
    }

    private async Task OnMaintenanceChanged(ChangeEventArgs args)
    {
        if (args.Value is not bool maintenanceActive)
            return;

        PatchConfigurationRequest request = new PatchConfigurationRequest
        {
            MaintenanceActive = maintenanceActive,
        };
        await DistagsApi.PatchConfigurationAsync(request);
        _MaintenanceActive = maintenanceActive;
    }

}
