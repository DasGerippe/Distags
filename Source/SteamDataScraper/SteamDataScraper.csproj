<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>82990268-95eb-4a1e-aa71-e4d1cdef393c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.4" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Distags.Core\Distags.Core.csproj" />
    <ProjectReference Include="..\Distags.Infrastructure\Distags.Infrastructure.csproj" />
    <ProjectReference Include="..\SerilogUtils\SerilogUtils.csproj" />
    <ProjectReference Include="..\SteamWebApi.Contract\SteamWebApi.Contract.csproj" />
    <ProjectReference Include="..\SteamWebApi\SteamWebApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
