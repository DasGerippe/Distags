<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="CsvHelper" Version="33.0.1" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.4" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\AutoTagging.Abstractions\AutoTagging.Abstractions.csproj" />
      <ProjectReference Include="..\Distags.Contracts\Distags.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Update="appsettings.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="maxter_tagging_all_levels.csv">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="maxter-tag-mapping.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <PropertyGroup>
      <AutoTaggerRunnerPluginsDir>$(MSBuildThisFileDirectory)..\AutoTaggerRunner\bin\$(Configuration)\$(TargetFramework)\Plugins\</AutoTaggerRunnerPluginsDir>
    </PropertyGroup>

    <!--
      AutoTaggerRunner loads this plugin via Assembly.LoadFrom, which only resolves dependencies
      that physically sit next to the loaded DLL in Plugins/ - unlike GameMode/MissingLevel, this
      project has extra NuGet dependencies (CsvHelper, Microsoft.Extensions.Configuration.Json),
      so the whole build output has to be copied, not just the plugin's own DLL. Uses MSBuild's
      Copy task rather than xcopy to avoid shell quoting/prompt issues with the multi-file wildcard copy.
    -->
    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
      <ItemGroup>
        <PluginOutputFiles Include="$(TargetDir)**\*.*" />
      </ItemGroup>
      <Copy SourceFiles="@(PluginOutputFiles)" DestinationFolder="$(AutoTaggerRunnerPluginsDir)%(RecursiveDir)" SkipUnchangedFiles="false" />
    </Target>

</Project>
